# Runner Dashboard environment template
# Copy to .env.local for local Vercel dev. Do not commit real secrets.

# Supabase
SUPABASE_URL=https://wjedqgrzuvkhnqctsmnd.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_JWKS_URL=https://wjedqgrzuvkhnqctsmnd.supabase.co/auth/v1/.well-known/jwks.json

# Backend only (server-side Vercel functions)
SUPABASE_SECRET_KEY=your_secret_key_here
RUNNER_SYNC_ACCESS_KEY=your_runner_sync_access_key_here

# Optional explicit override (defaults to ${SUPABASE_URL}/functions/v1/runner-sync)
RUNNER_SYNC_URL=https://wjedqgrzuvkhnqctsmnd.supabase.co/functions/v1/runner-sync

# Optional assistant integration
GITHUB_AGENT_API_TOKEN=your_github_token_here
