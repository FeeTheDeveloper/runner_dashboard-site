# Local development variables (do not put real secrets in tracked files)
# Copy this file to .env or .dev.vars and set real values locally.

GITHUB_AGENT_API_TOKEN=replace_with_your_new_token

# Vercel API integration path
VERCEL_API_BASE_PATH=/api
VERCEL_API_BASE_URL=https://your-project-name.vercel.app/api

# Supabase (server-side)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Never commit secret keys; set this only in Vercel/your local untracked env file.
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
